# Copy to .env in this directory. Never commit .env.
# Happy path needs none of these: local Ollama + on-disk RAG + no TTS publish.

# --- LLM (natural-language commands + optional draft polish) ---
# Default is local Ollama over HTTP. No vendor SDK is used.
# NONCAST_LLM_BACKEND=ollama
# NONCAST_LLM_MODEL=llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434

# Optional hosted LLMs (stdlib HTTP only; leave blank to disable)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Voice ---
# NONCAST_VOICE_BACKEND=f5-tts-mlx
# NONCAST_VOICE_ID=host-primary
# Local clone clip lives at voices/reference.wav and is gitignored.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# OPENAI_API_KEY=

# --- Runtime ---
# NONCAST_ROOT=
# NONCAST_ALLOW_NULL_VOICE=0
